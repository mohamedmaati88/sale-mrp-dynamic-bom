<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_component_selector_form_view" model="ir.ui.view">
        <field name="name">sale.component.selector.form</field>
        <field name="model">sale.component.selector</field>
        <field name="arch" type="xml">
            <form string="Select Components">
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="product_id" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <field name="sale_line_id" readonly="1"/>
                        <field name="product_tmpl_id" invisible="1"/>
                    </group>
                    <separator string="Available Components"/>
                    <field name="line_ids">
                        <list editable="bottom" string="Components"
                              create="0" delete="0"
                              decoration-muted="not is_selected">
                            <field name="sequence" widget="handle"/>
                            <field name="is_selected"/>
                            <field name="component_product_id" readonly="1"/>
                            <field name="group_id" readonly="1"/>
                            <field name="group_selection_mode" column_invisible="1"/>
                            <field name="qty" readonly="not is_selected"/>
                            <field name="uom_id" readonly="1" groups="uom.group_uom"/>
                            <field name="is_mandatory" readonly="1" optional="show"/>
                            <field name="notes" readonly="1" optional="show"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sale_component_selector_action" model="ir.actions.act_window">
        <field name="name">Select Components</field>
        <field name="res_model">sale.component.selector</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
