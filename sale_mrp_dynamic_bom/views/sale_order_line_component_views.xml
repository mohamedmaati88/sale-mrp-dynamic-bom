<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List view ─────────────────────────────────────────────────────── -->
    <record id="sale_order_line_component_list_view" model="ir.ui.view">
        <field name="name">sale.order.line.component.list</field>
        <field name="model">sale.order.line.component</field>
        <field name="arch" type="xml">
            <list string="Dynamic Component Selections" editable="bottom"
                  delete="0" duplicate="0">
                <field name="sale_line_id" column_invisible="1"/>
                <field name="component_product_id" string="Component"
                       domain="[('id', 'in', context.get('allowed_product_ids', []))]"
                       readonly="1"/>
                <field name="group_id" string="Group" readonly="1"/>
                <field name="qty" string="Quantity" readonly="1"/>
                <field name="uom_id" string="UoM" groups="uom.group_uom" readonly="1"/>
                <field name="sale_price" string="Unit Price"/>
                <field name="subtotal" string="Subtotal" readonly="1" sum="Total"/>
                <field name="notes" string="Notes" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── Form view ─────────────────────────────────────────────────────── -->
    <record id="sale_order_line_component_form_view" model="ir.ui.view">
        <field name="name">sale.order.line.component.form</field>
        <field name="model">sale.order.line.component</field>
        <field name="arch" type="xml">
            <form string="Dynamic Component Selection" create="0" edit="0">
                <sheet>
                    <group>
                        <group string="Order">
                            <field name="sale_line_id" readonly="1"/>
                        </group>
                        <group string="Component">
                            <field name="component_product_id" readonly="1"/>
                            <field name="group_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Quantity">
                            <field name="qty" readonly="1"/>
                            <field name="uom_id" readonly="1" groups="uom.group_uom"/>
                        </group>
                        <group string="Pricing">
                            <field name="sale_price" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes" invisible="not notes">
                        <field name="notes" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────────── -->
    <record id="sale_order_line_component_action" model="ir.actions.act_window">
        <field name="name">Dynamic Component Selections</field>
        <field name="res_model">sale.order.line.component</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                      (0, 0, {'view_mode': 'list', 'view_id': ref('sale_order_line_component_list_view')}),
                      (0, 0, {'view_mode': 'form', 'view_id': ref('sale_order_line_component_form_view')})]"/>
    </record>

</odoo>
