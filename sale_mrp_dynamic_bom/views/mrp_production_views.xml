<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_production_form_dynamic_bom" model="ir.ui.view">
        <field name="name">mrp.production.form.dynamic.bom</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="before">
                <field name="is_dynamic_bom" invisible="1"/>
                <field name="so_components_need_sync" invisible="1"/>
                <field name="so_price_needs_sync" invisible="1"/>
                <field name="show_manual_lock" invisible="1"/>
                <field name="source_so_cancelled" invisible="1"/>

                <!-- Source SO cancelled warning banner -->
                <div class="alert alert-danger mb-0 d-flex align-items-center gap-2"
                     role="alert"
                     invisible="not source_so_cancelled">
                    <i class="fa fa-exclamation-circle me-1"/>
                    <strong>Source Sale Order Cancelled</strong>
                </div>

                <!-- Manual lock toggle — visible only in manual lock mode -->
                <div class="alert alert-info mb-0 d-flex align-items-center gap-2"
                     role="alert"
                     invisible="not is_dynamic_bom or not show_manual_lock">
                    <i class="fa fa-lock me-1"/>
                    <span><strong>Component Update Lock</strong> — toggle to prevent
                    any further component updates from the Sale Order.</span>
                    <field name="lock_component_updates" class="ms-2"/>
                    <span invisible="not lock_component_updates" class="text-danger fw-bold">
                        Locked
                    </span>
                    <span invisible="lock_component_updates" class="text-success fw-bold">
                        Unlocked
                    </span>
                </div>

                <!-- Components or price out of sync warning -->
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not is_dynamic_bom or (not so_components_need_sync and not so_price_needs_sync)">
                    <i class="fa fa-exclamation-triangle me-1"/>
                    <strong>Update required</strong> — Component selections or prices have changed.
                    Please click <strong>Update</strong> on the Sale Order line before closing this MO.
                </div>

                <!-- Dynamic BOM info -->
                <div class="alert alert-info mb-0" role="alert"
                     invisible="not is_dynamic_bom">
                    <i class="fa fa-cubes me-1"/>
                    <strong>Dynamic BOM</strong> — raw materials come from the
                    Sale Order component selections.
                </div>
            </xpath>

        </field>
    </record>

</odoo>
