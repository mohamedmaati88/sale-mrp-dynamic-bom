<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Fix: safely guard o.date in external_layout_standard ────────── -->
    <!-- sale.order has no 'date' field; this prevents AttributeError       -->
    <template id="external_layout_standard_date_fix"
              inherit_id="web.external_layout_standard"
              priority="15">
        <xpath expr="//div[@t-if='o.date']" position="attributes">
            <attribute name="t-if">'date' in o._fields and o.date</attribute>
        </xpath>
    </template>

    <!-- ── Report Action ─────────────────────────────────────────────────── -->
    <record id="action_report_dynamic_components" model="ir.actions.report">
        <field name="name">Dynamic Components</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_mrp_dynamic_bom.report_dynamic_components</field>
        <field name="report_file">sale_mrp_dynamic_bom.report_dynamic_components</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ── Report Action (per SO line — from component list view) ──────── -->
    <record id="action_report_line_components" model="ir.actions.report">
        <field name="name">Components</field>
        <field name="model">sale.order.line.component</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_mrp_dynamic_bom.report_line_components</field>
        <field name="report_file">sale_mrp_dynamic_bom.report_line_components</field>
        <field name="binding_model_id" ref="sale_mrp_dynamic_bom.model_sale_order_line_component"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ── QWeb Template (per SO line) ──────────────────────────────────── -->
    <template id="report_line_components">
        <t t-call="web.html_container">
            <!-- Group the component records by their SO line -->
            <t t-set="lines" t-value="docs.mapped('sale_line_id')"/>
            <t t-foreach="lines" t-as="line">
                <t t-set="o" t-value="line.order_id"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb-4">
                            <div class="col-12">
                                <h3>Components Report</h3>
                                <p class="mb-0">
                                    <strong>Sale Order:</strong>
                                    <t t-esc="line.order_id.name"/>
                                </p>
                                <p class="mb-0">
                                    <strong>Customer:</strong>
                                    <t t-esc="line.order_id.partner_id.display_name"/>
                                </p>
                                <p class="mb-0">
                                    <strong>Product:</strong>
                                    <t t-esc="line.product_id.display_name"/>
                                    (Qty: <t t-esc="line.product_uom_qty"/>
                                    <t t-esc="line.product_uom_id.name"/>)
                                </p>
                                <p class="mb-0" t-if="line.last_component_update">
                                    <strong>Last Updated:</strong>
                                    <t t-esc="line.last_component_update"
                                       t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm:ss"}'/>
                                </p>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Component</th>
                                    <th>Group</th>
                                    <th class="text-center">Quantity</th>
                                    <th class="text-center">UoM</th>
                                    <t t-if="not line.product_id.disable_component_price_update">
                                        <t t-if="line.product_id.pricing_mode == 'components_cost'">
                                            <th class="text-end">Cost</th>
                                            <th class="text-end">
                                                <t t-if="line.product_id.margin_type == 'percentage'">Margin (%)</t>
                                                <t t-else="">Margin (Amt)</t>
                                            </th>
                                        </t>
                                        <th class="text-end">Unit Price</th>
                                        <th class="text-end">Subtotal</th>
                                    </t>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="line_comps" t-value="docs.filtered(lambda c: c.sale_line_id.id == line.id)"/>
                                <t t-foreach="line_comps" t-as="comp">
                                    <tr>
                                        <td><t t-esc="comp_index + 1"/></td>
                                        <td><t t-esc="comp.component_product_id.display_name"/></td>
                                        <td><t t-esc="comp.group_id.name or ''"/></td>
                                        <td class="text-center"><t t-esc="comp.qty"/></td>
                                        <td class="text-center"><t t-esc="comp.uom_id.name"/></td>
                                        <t t-if="not line.product_id.disable_component_price_update">
                                            <t t-if="line.product_id.pricing_mode == 'components_cost'">
                                                <td class="text-end">
                                                    <t t-esc="comp.component_product_id.standard_price"
                                                       t-options='{"widget": "monetary", "display_currency": line.order_id.currency_id}'/>
                                                </td>
                                                <td class="text-end">
                                                    <t t-if="line.product_id.margin_type == 'percentage'">
                                                        <t t-esc="'%.2f%%' % (comp.margin or 0)"/>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-esc="comp.margin or 0"
                                                           t-options='{"widget": "monetary", "display_currency": line.order_id.currency_id}'/>
                                                    </t>
                                                </td>
                                            </t>
                                            <td class="text-end">
                                                <t t-esc="comp.sale_price"
                                                   t-options='{"widget": "monetary", "display_currency": line.order_id.currency_id}'/>
                                            </td>
                                            <td class="text-end">
                                                <t t-esc="comp.subtotal * line.product_uom_qty"
                                                   t-options='{"widget": "monetary", "display_currency": line.order_id.currency_id}'/>
                                            </td>
                                        </t>
                                        <td><t t-esc="comp.notes or ''"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot t-if="not line.product_id.disable_component_price_update">
                                <tr>
                                    <t t-if="line.product_id.pricing_mode == 'components_cost'">
                                        <td colspan="7" class="text-end fw-bold">Total:</td>
                                    </t>
                                    <t t-else="">
                                        <td colspan="5" class="text-end fw-bold">Total:</td>
                                        <td></td>
                                    </t>
                                    <td class="text-end fw-bold">
                                        <t t-esc="sum(line_comps.mapped('subtotal')) * line.product_uom_qty"
                                           t-options='{"widget": "monetary", "display_currency": line.order_id.currency_id}'/>
                                    </td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ── QWeb Template (full SO — all dynamic lines) ───────────────────── -->
    <template id="report_dynamic_components">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="order">
                <t t-set="o" t-value="order"/>
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Header -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h3>Dynamic Components Report</h3>
                                <p class="mb-0">
                                    <strong>Sale Order:</strong>
                                    <t t-esc="order.name"/>
                                </p>
                                <p class="mb-0">
                                    <strong>Customer:</strong>
                                    <t t-esc="order.partner_id.display_name"/>
                                </p>
                                <p class="mb-0">
                                    <strong>Order Date:</strong>
                                    <t t-esc="order.date_order" t-options='{"widget": "datetime"}'/>
                                </p>
                            </div>
                        </div>

                        <!-- One section per dynamic SO line -->
                        <t t-foreach="order.order_line.filtered(lambda l: l.has_dynamic_components and l.selected_component_ids)" t-as="line">
                            <div class="mb-5">

                                <!-- Product heading -->
                                <h5 class="mt-3 mb-1">
                                    <t t-esc="line.product_id.display_name"/>
                                    <small class="text-muted ms-2">
                                        (Qty: <t t-esc="line.product_uom_qty"/>
                                        <t t-esc="line.product_uom_id.name"/>)
                                    </small>
                                </h5>
                                <p class="mb-2 text-muted" t-if="line.last_component_update">
                                    <em>Last updated:
                                        <t t-esc="line.last_component_update"
                                           t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm:ss"}'/>
                                    </em>
                                </p>

                                <!-- Components table -->
                                <table class="table table-sm table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th>#</th>
                                            <th>Component</th>
                                            <th>Group</th>
                                            <th class="text-center">Quantity</th>
                                            <th class="text-center">UoM</th>
                                            <t t-if="not line.product_id.disable_component_price_update">
                                                <th class="text-end">Unit Price</th>
                                                <th class="text-end">Subtotal</th>
                                            </t>
                                            <th>Notes</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="line.selected_component_ids" t-as="comp">
                                            <tr>
                                                <td><t t-esc="comp_index + 1"/></td>
                                                <td><t t-esc="comp.component_product_id.display_name"/></td>
                                                <td><t t-esc="comp.group_id.name or ''"/></td>
                                                <td class="text-center"><t t-esc="comp.qty"/></td>
                                                <td class="text-center"><t t-esc="comp.uom_id.name"/></td>
                                                <t t-if="not line.product_id.disable_component_price_update">
                                                    <td class="text-end">
                                                        <t t-esc="comp.sale_price"
                                                           t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                                    </td>
                                                    <td class="text-end">
                                                        <t t-esc="comp.subtotal * line.product_uom_qty"
                                                           t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                                    </td>
                                                </t>
                                                <td><t t-esc="comp.notes or ''"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                    <tfoot t-if="not line.product_id.disable_component_price_update">
                                        <tr>
                                            <td colspan="5" class="text-end fw-bold">Total:</td>
                                            <td></td>
                                            <td class="text-end fw-bold">
                                                <t t-esc="sum(line.selected_component_ids.mapped('subtotal')) * line.product_uom_qty"
                                                   t-options='{"widget": "monetary", "display_currency": order.currency_id}'/>
                                            </td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>


    <!-- ── Report Action (from Invoice) ─────────────────────────────────── -->
    <record id="action_report_invoice_dynamic_components" model="ir.actions.report">
        <field name="name">Dynamic Components</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_mrp_dynamic_bom.report_invoice_dynamic_components</field>
        <field name="report_file">sale_mrp_dynamic_bom.report_invoice_dynamic_components</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ── QWeb Template (from Invoice) ─────────────────────────────────── -->
    <!--
        Rendering modes, determined by snapshot state:
        1. Draft invoice              → live SO components (always up to date)
        2. Confirmed original invoice → 'normal' snapshots (frozen at post time)
        3. Adjustment invoice         → 'addition' snapshots (what was added)
        4. Adjustment credit note     → 'reduction' snapshots (what was removed)
        5. Confirmed, no snapshots    → live SO components (module installed after posting)
    -->
    <template id="report_invoice_dynamic_components">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="invoice">
                <t t-set="o" t-value="invoice"/>
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- ── Header ── -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h3>Dynamic Components Report</h3>
                                <p class="mb-0">
                                    <strong>Invoice:</strong>
                                    <t t-esc="invoice.name or 'Draft'"/>
                                </p>
                                <p class="mb-0">
                                    <strong>Customer:</strong>
                                    <t t-esc="invoice.partner_id.display_name"/>
                                </p>
                                <p class="mb-0">
                                    <strong>Invoice Date:</strong>
                                    <t t-esc="invoice.invoice_date"
                                       t-options='{"widget": "date"}'/>
                                </p>
                                <p class="mb-0" t-if="invoice.invoice_origin">
                                    <strong>Source:</strong>
                                    <t t-esc="invoice.invoice_origin"/>
                                </p>
                            </div>
                        </div>

                        <!-- ── Classify this invoice ── -->
                        <t t-set="normal_snaps"    t-value="invoice.component_snapshot_ids.filtered(lambda s: s.snapshot_type == 'normal')"/>
                        <t t-set="addition_snaps"  t-value="invoice.component_snapshot_ids.filtered(lambda s: s.snapshot_type == 'addition')"/>
                        <t t-set="reduction_snaps" t-value="invoice.component_snapshot_ids.filtered(lambda s: s.snapshot_type == 'reduction')"/>

                        <!-- ════════════════════════════════════════════════════
                             MODE 1: NO SNAPSHOTS (draft or legacy confirmed)
                             → Show live components from linked SO lines
                             Snapshots are always checked first; this mode only
                             applies when the invoice has no snapshots at all.
                             ════════════════════════════════════════════════════ -->
                        <t t-if="not invoice.component_snapshot_ids">
                            <t t-set="dynamic_lines" t-value="invoice.invoice_line_ids.mapped('sale_line_ids').filtered(lambda l: l.has_dynamic_components and l.selected_component_ids)"/>
                            <t t-if="not dynamic_lines">
                                <p class="text-muted">No dynamic components found for this invoice.</p>
                            </t>
                            <t t-foreach="dynamic_lines" t-as="line">
                                <!-- Invoiced qty for this SO line in this specific invoice -->
                                <t t-set="inv_qty" t-value="sum(invoice.invoice_line_ids.filtered(lambda l: line in l.sale_line_ids).mapped('quantity')) or line.product_uom_qty"/>
                                <div class="mb-5">
                                    <h5 class="mt-3 mb-1">
                                        <t t-esc="line.product_id.display_name"/>
                                        <small class="text-muted ms-2">
                                            (Qty: <t t-esc="inv_qty"/>
                                            <t t-esc="line.product_uom_id.name"/>)
                                        </small>
                                    </h5>
                                    <p class="mb-2 text-muted" t-if="line.last_component_update">
                                        <em>Last updated:
                                            <t t-esc="line.last_component_update"
                                               t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm:ss"}'/>
                                        </em>
                                    </p>
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>#</th>
                                                <th>Component</th>
                                                <th>Group</th>
                                                <th class="text-center">Quantity</th>
                                                <th class="text-center">UoM</th>
                                                <t t-if="not line.product_id.disable_component_price_update">
                                                    <th class="text-end">Unit Price</th>
                                                    <th class="text-end">Subtotal</th>
                                                </t>
                                                <th>Notes</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="line.selected_component_ids" t-as="comp">
                                                <tr>
                                                    <td><t t-esc="comp_index + 1"/></td>
                                                    <td><t t-esc="comp.component_product_id.display_name"/></td>
                                                    <td><t t-esc="comp.group_id.name or ''"/></td>
                                                    <td class="text-center"><t t-esc="comp.qty"/></td>
                                                    <td class="text-center"><t t-esc="comp.uom_id.name"/></td>
                                                    <t t-if="not line.product_id.disable_component_price_update">
                                                        <td class="text-end">
                                                            <t t-esc="comp.sale_price"
                                                               t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                        </td>
                                                        <td class="text-end">
                                                            <t t-esc="comp.subtotal * inv_qty"
                                                               t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                        </td>
                                                    </t>
                                                    <td><t t-esc="comp.notes or ''"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                        <tfoot t-if="not line.product_id.disable_component_price_update">
                                            <tr>
                                                <td colspan="5" class="text-end fw-bold">Total:</td>
                                                <td></td>
                                                <td class="text-end fw-bold">
                                                    <t t-esc="sum(line.selected_component_ids.mapped('subtotal')) * inv_qty"
                                                       t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                </td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </t>
                        </t>

                        <!-- ════════════════════════════════════════════════════
                             MODE 2: CONFIRMED ORIGINAL INVOICE
                             → Show 'normal' snapshots grouped by SO line
                             ════════════════════════════════════════════════════ -->
                        <t t-elif="normal_snaps and not addition_snaps and not reduction_snaps">
                            <p class="text-muted fst-italic mb-3">
                                Components as recorded at the time of invoice confirmation.
                            </p>
                            <t t-set="snap_lines" t-value="normal_snaps.mapped('sale_line_id')"/>
                            <t t-foreach="snap_lines" t-as="sol">
                                <!-- Product heading (fall back to stored name if line is gone) -->
                                <t t-set="line_snaps"  t-value="normal_snaps.filtered(lambda s: s.sale_line_id.id == sol.id)"/>
                                <!-- Respect disable_component_price_update per product -->
                                <t t-set="show_price"  t-value="not sol.product_id.disable_component_price_update"/>
                                <!-- Invoiced qty for this SO line in this specific invoice -->
                                <t t-set="inv_qty" t-value="sum(invoice.invoice_line_ids.filtered(lambda l: sol in l.sale_line_ids).mapped('quantity')) or sol.product_uom_qty"/>
                                <div class="mb-5">
                                    <h5 class="mt-3 mb-1">
                                        <t t-esc="sol.product_id.display_name or (line_snaps and line_snaps[0].product_display_name) or ''"/>
                                        <small class="text-muted ms-2" t-if="inv_qty">
                                            (Qty: <t t-esc="inv_qty"/>
                                            <t t-esc="sol.product_uom_id.name"/>)
                                        </small>
                                    </h5>
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>#</th>
                                                <th>Component</th>
                                                <th>Group</th>
                                                <th class="text-center">Quantity</th>
                                                <th class="text-center">UoM</th>
                                                <th t-if="show_price" class="text-end">Unit Price</th>
                                                <th t-if="show_price" class="text-end">Subtotal</th>
                                                <th>Notes</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="line_snaps" t-as="snap">
                                                <tr>
                                                    <td><t t-esc="snap_index + 1"/></td>
                                                    <td><t t-esc="snap.component_product_id.display_name"/></td>
                                                    <td><t t-esc="snap.group_id.name or ''"/></td>
                                                    <td class="text-center"><t t-esc="snap.qty"/></td>
                                                    <td class="text-center"><t t-esc="snap.uom_id.name or ''"/></td>
                                                    <t t-if="show_price">
                                                        <td class="text-end">
                                                            <t t-esc="snap.sale_price"
                                                               t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                        </td>
                                                        <td class="text-end">
                                                            <t t-esc="snap.subtotal * inv_qty"
                                                               t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                        </td>
                                                    </t>
                                                    <td><t t-esc="snap.notes or ''"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                        <tfoot t-if="show_price">
                                            <tr>
                                                <td colspan="5" class="text-end fw-bold">Total:</td>
                                                <td></td>
                                                <td class="text-end fw-bold">
                                                    <t t-esc="sum(line_snaps.mapped('subtotal')) * inv_qty"
                                                       t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                </td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </t>
                        </t>

                        <!-- ════════════════════════════════════════════════════
                             MODE 3: ADJUSTMENT DOCUMENT
                             → Any combination of addition / reduction snapshots
                             → Single table with Status column per SO line
                             ════════════════════════════════════════════════════ -->
                        <t t-elif="addition_snaps or reduction_snaps">
                            <!-- All diff snapshots for this document -->
                            <t t-set="adj_snaps" t-value="invoice.component_snapshot_ids.filtered(lambda s: s.snapshot_type in ('addition', 'reduction'))"/>

                            <!-- Resolve the linked sale order for invoice cross-reference -->
                            <t t-set="first_sol" t-value="adj_snaps and adj_snaps[0].sale_line_id"/>
                            <t t-set="adj_order"  t-value="first_sol and first_sol.order_id"/>

                            <!-- All posted invoices for this SO (excluding the current one) -->
                            <t t-set="adj_inv_ids"       t-value="adj_order and adj_order.adjustment_invoice_ids.ids or []"/>
                            <t t-set="orig_posted"        t-value="adj_order and adj_order.invoice_ids.filtered(lambda m: m.id not in adj_inv_ids and m.state == 'posted' and m.move_type == 'out_invoice').sorted(lambda m: m.invoice_date or m.date) or []"/>
                            <t t-set="all_prev_posted"    t-value="adj_order and adj_order.invoice_ids.filtered(lambda m: m.state == 'posted' and m.id != invoice.id).sorted(lambda m: m.invoice_date or m.date) or []"/>
                            <t t-set="source_invoice"     t-value="orig_posted and orig_posted[0]"/>
                            <t t-set="last_prev_invoice"  t-value="all_prev_posted and all_prev_posted[-1]"/>

                            <!-- Update date from first snapshot (same for all rows in one update) -->
                            <t t-set="update_dt" t-value="adj_snaps and adj_snaps[0].update_date"/>

                            <!-- ── Banner ── -->
                            <div class="alert alert-info mb-3 p-3" role="alert">
                                <strong>Price Adjustment</strong> —
                                This adjustment reflects changes made after the previous invoice.
                                <t t-if="update_dt">
                                    <br/>
                                    <small class="text-muted">
                                        Components updated on:
                                        <strong>
                                            <t t-esc="update_dt"
                                               t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm:ss"}'/>
                                        </strong>
                                    </small>
                                </t>
                            </div>

                            <!-- ── Invoice cross-references ── -->
                            <div class="row mb-4">
                                <div class="col-6" t-if="source_invoice">
                                    <p class="mb-0">
                                        <strong>Source Invoice:</strong>
                                        <t t-esc="source_invoice.name"/>
                                        <span class="text-muted ms-1">
                                            (<t t-esc="source_invoice.invoice_date"
                                               t-options='{"widget": "date"}'/>)
                                        </span>
                                    </p>
                                </div>
                                <div class="col-6" t-if="last_prev_invoice">
                                    <p class="mb-0">
                                        <strong>Last Invoice:</strong>
                                        <t t-esc="last_prev_invoice.name"/>
                                        <span class="text-muted ms-1">
                                            (<t t-esc="last_prev_invoice.invoice_date"
                                               t-options='{"widget": "date"}'/>)
                                        </span>
                                    </p>
                                </div>
                            </div>

                            <!-- ── One section per SO line ── -->
                            <t t-set="adj_sol_ids" t-value="adj_snaps.mapped('sale_line_id')"/>
                            <t t-foreach="adj_sol_ids" t-as="sol">
                                <t t-set="sol_snaps"   t-value="adj_snaps.filtered(lambda s: s.sale_line_id.id == sol.id)"/>
                                <!-- Respect the product's disable_component_price_update flag -->
                                <t t-set="show_price"  t-value="not sol.product_id.disable_component_price_update"/>
                                <!-- Adjustment invoice: qty is stored on the invoice line (= previously invoiced qty) -->
                                <t t-set="inv_qty" t-value="sum(invoice.invoice_line_ids.filtered(lambda l: l.product_id.id == sol.product_id.id and l.display_type == 'product').mapped('quantity')) or sol.product_uom_qty"/>
                                <div class="mb-5">
                                    <h5 class="mt-3 mb-1">
                                        <t t-esc="sol.product_id.display_name or (sol_snaps and sol_snaps[0].product_display_name) or ''"/>
                                        <small class="text-muted ms-2">
                                            (Qty: <t t-esc="inv_qty"/>
                                            <t t-esc="sol.product_uom_id.name"/>)
                                        </small>
                                    </h5>
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>#</th>
                                                <th>Component</th>
                                                <th class="text-center">Status</th>
                                                <th>Group</th>
                                                <th class="text-center">Quantity</th>
                                                <th class="text-center">UoM</th>
                                                <th t-if="show_price" class="text-end">Unit Price</th>
                                                <th t-if="show_price" class="text-end">Subtotal</th>
                                                <th>Notes</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="sol_snaps" t-as="snap">
                                                <tr>
                                                    <td><t t-esc="snap_index + 1"/></td>
                                                    <td><t t-esc="snap.component_product_id.display_name"/></td>
                                                    <td class="text-center">
                                                        <!-- Use t-if/t-elif and inline style to guarantee PDF rendering -->
                                                        <t t-if="snap.snapshot_type == 'addition'">
                                                            <strong style="color:#198754;">Addition</strong>
                                                        </t>
                                                        <t t-elif="snap.snapshot_type == 'reduction'">
                                                            <strong style="color:#dc3545;">Removal</strong>
                                                        </t>
                                                    </td>
                                                    <td><t t-esc="snap.group_id.name or ''"/></td>
                                                    <td class="text-center"><t t-esc="snap.qty"/></td>
                                                    <td class="text-center"><t t-esc="snap.uom_id.name or ''"/></td>
                                                    <t t-if="show_price">
                                                        <td class="text-end">
                                                            <t t-esc="snap.sale_price"
                                                               t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                        </td>
                                                        <td class="text-end">
                                                            <!-- Additions positive, reductions in parentheses -->
                                                            <t t-if="snap.snapshot_type == 'addition'">
                                                                <t t-esc="snap.subtotal * inv_qty"
                                                                   t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                            </t>
                                                            <t t-elif="snap.snapshot_type == 'reduction'">
                                                                (<t t-esc="snap.subtotal * inv_qty"
                                                                   t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>)
                                                            </t>
                                                        </td>
                                                    </t>
                                                    <td><t t-esc="snap.notes or ''"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                        <tfoot t-if="show_price">
                                            <tr>
                                                <td colspan="6" class="text-end fw-bold">Net Adjustment:</td>
                                                <td></td>
                                                <td class="text-end fw-bold">
                                                    <t t-esc="(sum(s.subtotal for s in sol_snaps if s.snapshot_type == 'addition') - sum(s.subtotal for s in sol_snaps if s.snapshot_type == 'reduction')) * inv_qty"
                                                       t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                </td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </t>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
